{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "richfolio-scheduler",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",

  // Free-plan Cron Triggers are capped at 5 per ACCOUNT (not per Worker), so
  // these four leave exactly one spare for anything else on the account. The
  // mapping from each expression to a repository_dispatch event type lives in
  // TRIGGERS in src/index.js — keep the two in sync, the keys are matched
  // verbatim against the `cron` field Cloudflare hands to scheduled().
  "triggers": {
    "crons": [
      "0 22 * * *", // daily brief      — 8:00am AEST
      "30 22 * * 0", // weekly report    — Monday 8:30am AEST
      "15 3,7,11,14 * * 1-5", // intraday checks  — 1:15pm/5:15pm/9:15pm/12:15am AEST
      "0 */3 * * *" // crypto pairs     — every 3 hours
    ]
  },

  // Not a secret: it is in the git remote URL already.
  "vars": {
    "GITHUB_REPO": "furic/richfolio"
  },

  // Secrets (set via `npx wrangler secret put <NAME>`, never in this file):
  //   GITHUB_TOKEN  — required. Fine-grained PAT scoped to furic/richfolio with
  //                   `Contents: read & write`, which is what the
  //                   repository_dispatch API needs.
  //   TRIGGER_TOKEN — optional. Enables the manual HTTP trigger; the fetch
  //                   handler returns 404 while unset.

  // Free-plan Workers get logs too. Worth having: the whole point of this
  // Worker is punctuality, and the invocation log is where you check it.
  "observability": {
    "enabled": true
  }
}
